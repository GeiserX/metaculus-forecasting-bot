# Copy to $STATE_DIR/secrets.env (default ~/.metaculus-bot/secrets.env) and chmod 600. Never commit it.

# Metaculus bot token: Metaculus > Settings > My Forecasting Bots > Reveal API Key
METACULUS_TOKEN=

# Claude Code token for headless runs: run `claude setup-token` and paste the result
CLAUDE_CODE_OAUTH_TOKEN=

# Live tournament runs stay off until this is 1. Set it after a dry run passes.
LIVE=0

# Optional overrides (defaults shown)
# LLM_BACKEND=claude-code
# RESEARCH_MODEL=claude-sonnet-5-5
# FORECAST_MODELS=claude-opus-5-5
# PREDICTIONS_PER_QUESTION=5
# RESEARCH_TIMEOUT=600
# FORECAST_TIMEOUT=300
